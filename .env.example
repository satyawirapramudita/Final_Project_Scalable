# ─────────────────────────────────────────────────────────────
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env.
# ─────────────────────────────────────────────────────────────

# ── MySQL (satu server, database logis terpisah per layanan) ──
MYSQL_ROOT_PASSWORD=ganti_root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# auth
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=ganti_auth_password

# poem
POEM_DB_NAME=poem_db
POEM_DB_USER=poem_user
POEM_DB_PASSWORD=ganti_poem_password

# Connection pool MySQL (poem & auth). Naikkan DB_POOL_MAX saat stress test
# bila MySQL punya max_connections lebih besar.
DB_POOL_MIN=2
DB_POOL_MAX=10

# Berapa lama Idempotency-Key diingat untuk dedup submit (detik; 24 jam).
IDEMPOTENCY_TTL=86400

# wordcloud
WORDCLOUD_DB_NAME=wordcloud_db
WORDCLOUD_DB_USER=wordcloud_user
WORDCLOUD_DB_PASSWORD=ganti_wordcloud_password

# kbbi-linker
KBBI_DB_NAME=kbbi_db
KBBI_DB_USER=kbbi_user
KBBI_DB_PASSWORD=ganti_kbbi_password
KBBI_DATASET_VERSION=kbbi-v-local
KBBI_ENTRY_CACHE_TTL_SECONDS=2592000
KBBI_POEM_CACHE_TTL_SECONDS=86400
KBBI_NEGATIVE_CACHE_TTL_SECONDS=86400

# search (indeks pencarian MySQL FULLTEXT)
SEARCH_DB_NAME=search_db
SEARCH_DB_USER=search_user
SEARCH_DB_PASSWORD=ganti_search_password

# ── JWT (dibagikan ke semua layanan untuk verifikasi lokal) ──
# Default 1440 menit (24 jam) agar user tidak sering logout saat demo.
JWT_SECRET=ganti_secret_jwt_panjang_acak_minimal_32_karakter
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── RabbitMQ ──
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=puisi
RABBITMQ_PASSWORD=ganti_rabbit_password
RABBITMQ_VHOST=/

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379

# ── Aset statis / gambar puisi (CloudFront/S3) ──
# Kosongkan untuk dev lokal
ASSET_BASE_URL=

# ── Port host untuk gateway ──
GATEWAY_PORT=8080

# ── Rate limit gateway (per IP klien) ──
# Default cukup untuk pemakaian normal. Saat uji beban dari satu mesin,
# naikkan agar generator beban tidak dibatasi gateway, mis. 2000r/s dan 500.
API_RATE_LIMIT=20r/s
API_BURST=40

# ── Micro-cache gateway (wordcloud & kbbi, plus pencarian per pengguna) ──
# API_CACHE=off mematikan cache (mis. untuk membandingkan saat uji beban).
API_CACHE=api_cache
API_CACHE_TTL=30s
API_SEARCH_CACHE_TTL=10s

# ── Grafana ──
# Login admin; ganti sebelum deploy. Port hanya dibind ke 127.0.0.1.
GRAFANA_ADMIN_PASSWORD=ganti_grafana_password
