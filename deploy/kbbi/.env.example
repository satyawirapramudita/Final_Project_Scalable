# Salin menjadi .env pada setiap EC2 dan isi hanya variabel yang diperlukan.
# Jangan commit file .env yang berisi secret.

# MySQL EC2
MYSQL_ROOT_PASSWORD=ganti_root_password_yang_kuat
MYSQL_BIND_ADDRESS=0.0.0.0
MYSQL_PORT=3306
KBBI_DB_NAME=kbbi_db
KBBI_DB_USER=kbbi_user
KBBI_DB_PASSWORD=ganti_kbbi_password_yang_kuat

# Redis EC2. Lindungi port 6379 dengan Security Group agar hanya service EC2 yang dapat masuk.
REDIS_BIND_ADDRESS=0.0.0.0
REDIS_PORT=6379

# RabbitMQ EC2
RABBITMQ_BIND_ADDRESS=0.0.0.0
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_BIND_ADDRESS=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=puisi
RABBITMQ_PASSWORD=ganti_rabbitmq_password_yang_kuat
RABBITMQ_VHOST=/

# kbbi-linker EC2: gunakan private DNS Route 53 atau private IP EC2.
KBBI_DB_HOST=mysql.internal.puisi
KBBI_DB_PORT=3306
KBBI_REDIS_HOST=redis.internal.puisi
KBBI_REDIS_PORT=6379
KBBI_RABBITMQ_HOST=rabbitmq.internal.puisi
KBBI_RABBITMQ_PORT=5672
KBBI_BIND_ADDRESS=0.0.0.0
KBBI_SERVICE_PORT=8005

JWT_SECRET=ganti_secret_yang_sama_dengan_auth_minimal_32_karakter
JWT_ALGORITHM=HS256
KBBI_DATASET_VERSION=kbbi-v-local
