# ─────────────────────────────────────────────────────────────
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env.
# ─────────────────────────────────────────────────────────────

# ── MySQL (satu server, database logis terpisah per layanan) ──
MYSQL_ROOT_PASSWORD=ganti_root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# auth
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=ganti_auth_password

# poem
POEM_DB_NAME=poem_db
POEM_DB_USER=poem_user
POEM_DB_PASSWORD=ganti_poem_password

# wordcloud
WORDCLOUD_DB_NAME=wordcloud_db
WORDCLOUD_DB_USER=wordcloud_user
WORDCLOUD_DB_PASSWORD=ganti_wordcloud_password

# wiki-linker
WIKI_DB_NAME=wiki_db
WIKI_DB_USER=wiki_user
WIKI_DB_PASSWORD=ganti_wiki_password

# search (indeks pencarian MySQL FULLTEXT)
SEARCH_DB_NAME=search_db
SEARCH_DB_USER=search_user
SEARCH_DB_PASSWORD=ganti_search_password

# ── JWT (dibagikan ke semua layanan untuk verifikasi lokal) ──
JWT_SECRET=ganti_secret_jwt_panjang_acak_minimal_32_karakter
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── RabbitMQ ──
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=puisi
RABBITMQ_PASSWORD=ganti_rabbit_password
RABBITMQ_VHOST=/

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379

# ── Aset statis / gambar puisi (CloudFront/S3) ──
# Kosongkan untuk dev lokal
ASSET_BASE_URL=

# ── Port host untuk gateway ──
GATEWAY_PORT=8080

# ── Rate limit gateway (per IP klien) ──
# Default cukup untuk pemakaian normal. Saat uji beban dari satu mesin,
# naikkan agar generator beban tidak dibatasi gateway, mis. 2000r/s dan 500.
API_RATE_LIMIT=20r/s
API_BURST=40

# ── Grafana ──
# Login admin; ganti sebelum deploy. Port hanya dibind ke 127.0.0.1.
GRAFANA_ADMIN_PASSWORD=ganti_grafana_password
